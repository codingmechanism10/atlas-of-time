# Netlify / Cloudflare Pages.
# The app has no build step, so module filenames never change. Code must
# therefore revalidate on every request, or a deploy leaves returning users
# with a half-updated module graph.
/*
  Cache-Control: no-cache, must-revalidate
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# data/ is regenerated from upstream dumps periodically and the filenames do
# not change, so it must revalidate — a 304 skips the body, which is the cost.
# vendor/ is a pinned library and genuinely never changes.
/vendor/*
  Cache-Control: public, max-age=31536000, immutable
